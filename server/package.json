{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@pothos/core": "^4.13.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.21.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
